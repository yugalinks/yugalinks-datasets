{
  "manifest_version": "1.0",
  "status": "planning",
  "purpose": "Define how PSEO page inputs become reproducible dataset packages without treating every rendered page as a separate external upload.",
  "count_semantics": {
    "eligible_inputs_are": "filtered page or route candidates",
    "eligible_inputs_are_not": "unique downloadable files, raw source rows, or platform listings",
    "candidate_count_before_caps": 23233391,
    "candidate_count_with_t13_cap": 5722424
  },
  "distribution_policy": {
    "catalog_unit": "one logical entry per eligible page input",
    "download_unit": "partitioned family collection or filtered family download",
    "default_release_status": "not_released",
    "avoid": "one external platform listing per rendered page",
    "row_policy": "preserve the natural source grain; never pad a package with synthetic rows",
    "context_policy": "separately sourced context requires source-specific licensing review"
